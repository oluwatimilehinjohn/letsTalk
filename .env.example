# Existing application (copy values into .env; never commit real credentials)
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/letstalk
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: avatar upload requires a real Cloudinary account.
CLOUDINARY_URL=

# Local Docker PostgreSQL credentials, for development only.
POSTGRES_USER=letstalk
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=letstalk
DATABASE_URL=postgresql://letstalk:local-development-only@127.0.0.1:5432/letstalk
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=lets-talk
# Leave false to run the original MongoDB-only chat during incremental rollout.
EVENTS_ENABLED=true
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=lets-talk
KAFKA_GROUP_ID=lets-talk
KAFKA_TOPIC=lets-talk.domain.v1
KAFKA_DLQ_TOPIC=lets-talk.dead-letter.v1
OUTBOX_POLL_MS=1000
# Daily emails are fixed at 07:00 Africa/Lagos; this timezone applies to cleanup only.
MAINTENANCE_CRON=0 3 * * *
SCHEDULE_TIMEZONE=Africa/Lagos

# Real email delivery: verify your sending domain with Resend first.
RESEND_API_KEY=re_Uf3UXiy2_AtFKzLWdmSghG19njUb4QkeT
EMAIL_FROM=Let's Talk <hello@letstalk.com>
APP_URL=https://letstalk-oesu.onrender.com/
