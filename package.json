{
  "name": "chatcord",
  "version": "1.0.0",
  "description": "Realtime chat app with rooms",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "start": "node server",
    "dev": "nodemon server",
    "migrate:message-rooms": "node scripts/migrateMessagesToRoomIds.js",
    "backfill:room-activity": "node scripts/backfillRoomActivity.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "infra:up": "docker compose up -d --wait",
    "infra:stop": "docker compose stop",
    "kafka:setup": "node scripts/kafkaSetup.js",
    "workers": "node scripts/background.js all",
    "workers:only": "node scripts/background.js workers",
    "consumers": "node scripts/background.js consumers",
    "events:relay": "node scripts/background.js relay",
    "schedule": "node scripts/background.js scheduler",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "check": "node scripts/check.js",
    "jobs:inspect": "node scripts/inspectJobs.js"
  },
  "author": "timi",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@socket.io/redis-adapter": "^7.1.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "5.58.5",
    "cloudinary": "^2.10.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^14.3.2",
    "express": "^4.17.1",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "ioredis": "5.7.0",
    "kafkajs": "2.2.4",
    "moment": "^2.24.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.8.0",
    "multer": "^2.2.0",
    "redis": "^4.0.2",
    "socket.io": "^4.4.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.2",
    "prisma": "6.19.0",
    "socket.io-client": "^4.8.3"
  }
}
